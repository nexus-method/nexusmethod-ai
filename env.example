# nexusmethod.ai — environment variables
# Copy to .env.local and fill in values. Never commit .env.local to git.
# Server-side vars (no NEXT_PUBLIC_ prefix) are only readable by serverless
# functions and are never shipped in the client bundle.

# Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX   # add after GA4 property setup

# Contact form → ClickUp Lead Pipeline (used by src/app/api/contact/route.ts)
# CLICKUP_TOKEN is a ClickUp personal API token. Server-side only.
CLICKUP_TOKEN=pk_xxx
# Destination list (defaults to Nexus Method → Pipeline → Lead Pipeline)
CLICKUP_LEAD_LIST_ID=901416970838

# Booking links (currently hardcoded in src/content.ts; kept here for reference)
# Discovery Call (free, 30 min):
#   https://calendly.com/molly-nexusmethod/30min
# AI Readiness Assessment ($499, collected via Stripe at booking):
#   https://calendly.com/molly-nexusmethod/ai-readiness-assessment
