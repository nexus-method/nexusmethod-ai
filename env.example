# nexusmethod.ai — environment variables
# Copy to .env.local and fill in values. Never commit .env.local to git.

# Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX   # add after GA4 property setup

# Contact form endpoint (OQ-7 — wire before launch)
# Option A: Formspree
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
# Option B: n8n webhook
# NEXT_PUBLIC_FORM_ENDPOINT=https://your-n8n-url/webhook/contact

# Calendly (OQ-7 — confirm URL before launch)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/molly-nexusmethod/discovery-call
